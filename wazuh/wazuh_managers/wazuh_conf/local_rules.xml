<group name="local,attack_override,">

  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Firewall SCAN events (iptables LOG with SCAN prefix) -->
  <!-- no_log: 不產生警報，只用來計數給 100110 -->
  <rule id="100100" level="3">
    <if_sid>4100</if_sid>
    <action>SCAN:</action>
    <description>Firewall: Port scan detected (iptables SCAN log).</description>
    <options>no_log</options>
    <group>firewall_scan,nmap,</group>
  </rule>

  <!-- 同一來源 30 秒內掃描超過 10 次才觸發一次警報 -->
  <rule id="100110" level="10" frequency="10" timeframe="30" ignore="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Firewall: Repeated port scan from same source - possible nmap scan.</description>
    <group>firewall_scan,nmap,attack,</group>
  </rule>

  <!-- DDoS / Flood -->
  <rule id="100101" level="10">
    <if_group>dos</if_group>
    <description>Override: DoS/DDoS detected - elevated to level 10</description>
  </rule>

  <!-- Multiple firewall DROP from same source -->
  <rule id="100103" level="8">
    <if_sid>4101</if_sid>
    <description>Firewall: DROP event detected.</description>
    <group>firewall_drop,</group>
  </rule>

</group>
